# Add at least one key. Whichever key is present turns that engine on.
# If several are present, Gemini is used first, then Anthropic, then OpenAI.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Force an engine when several keys are present: gemini, anthropic or openai.
# PROVIDER=gemini

# Optional. Defaults: gemini-3.8-flash, claude-opus-5-5, gpt-6-astra.
# MODEL=gemini-3.8-flash

# Optional. Anthropic only: low, medium, high, xhigh or max.
# EFFORT=medium

# PORT=3000

# Add at least one key. Whichever key is present turns that engine on.
# If several are present, Gemini is used first, then Anthropic, then OpenAI.
# <note>i tested everything using gemini key.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional spending guardrails.
# DAILY_BUDGET_USD=1
# MAX_MESSAGES_PER_MINUTE=10
# MAX_MESSAGES_PER_DAY=200

# Optional: how hard the model thinks before answering. low is fastest; medium or high trade speed for depth.
# EFFORT=low

# Guardrails: every limit lives in src/config/guardrails.ts with the reason it exists.
# Any of them can be changed here as GUARD_ plus its name in capitals. Shrinking them is the
# easy way to test what happens at a limit. Mino prints the ones you changed at startup.
# GUARD_MAX_ROUNDS=6            # API requests in one reply
# GUARD_MAX_TOOL_CALLS=6        # connected (MCP) tool calls in one reply
# GUARD_MAX_HISTORY_CALLS=4     # search_history lookups in one reply
# GUARD_MAX_OUTPUT_TOKENS=8000  # per API request, thinking included
# GUARD_HISTORY_CHARS=30000     # characters of the current chat sent word for word
# GUARD_MAX_TOOL_RESULT_CHARS=12000

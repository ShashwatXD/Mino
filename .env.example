# Add at least one key. Whichever key is present turns that engine on.
# If several are present, Gemini is used first, then Anthropic, then OpenAI.
# <note>i tested everything using gemini key.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional spending guardrails.
# DAILY_BUDGET_USD=1
# MAX_MESSAGES_PER_MINUTE=10
# MAX_MESSAGES_PER_DAY=200

# Optional: how hard the model thinks before answering. low is fastest; medium or high trade speed for depth.
# EFFORT=low
